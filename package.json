{
  "name": "ethio-poultry-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run env:check && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:db:integration": "node scripts/run-database-integration.mjs",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "test:browser:provision-local": "node scripts/provision-local-e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "env:check": "node scripts/deployment-check.mjs env",
    "migrations:verify": "node scripts/deployment-check.mjs migrations",
    "migrations:lock": "node scripts/deployment-check.mjs lock",
    "db:verify": "node scripts/verify-database.mjs",
    "db:history:inspect": "node scripts/database-release.mjs inspect",
    "db:history:adopt": "node scripts/database-release.mjs adopt",
    "db:deploy": "node scripts/database-release.mjs deploy",
    "db:bootstrap": "node scripts/database-release.mjs bootstrap",
    "release:manifest": "node scripts/deployment-check.mjs manifest",
    "release:verify": "npm run env:check && npm run migrations:verify && npm run check && npm run build",
    "monitor:probe": "node scripts/platform-monitoring.mjs probe",
    "monitor:backup": "node scripts/platform-monitoring.mjs backup",
    "recovery:drill": "node scripts/run-recovery-drill.mjs",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env staging --keep-vars",
    "cloudflare:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cloudflare:types": "wrangler types --include-runtime false",
    "supabase": "supabase"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.28",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "ai": "^7.0.64",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.38",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5",
    "wrangler": "4.120.1"
  }
}
