{
  "name": "ethio-poultry-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run env:check && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "env:check": "node scripts/deployment-check.mjs env",
    "migrations:verify": "node scripts/deployment-check.mjs migrations",
    "migrations:lock": "node scripts/deployment-check.mjs lock",
    "db:verify": "node scripts/verify-database.mjs",
    "release:manifest": "node scripts/deployment-check.mjs manifest",
    "release:verify": "npm run env:check && npm run migrations:verify && npm run check && npm run build",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.38",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  }
}
