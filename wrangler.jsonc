{
  // Runtime monitoring credentials are Worker secrets; they are never required during compilation.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ethio-poultry-app",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENVIRONMENT": "production",
    "APP_BASE_URL": "https://ethio-poultry-app.walidmurad65.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://gnmeoxwqexennoidwwpf.supabase.co",
    "SUPABASE_PROJECT_REF": "gnmeoxwqexennoidwwpf"
  },
  "secrets": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "ADMIN_ACCESS_CODE",
      "MONITORING_INGEST_TOKEN"
    ]
  },
  "env": {
    "staging": {
      "name": "ethio-poultry-app-staging",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        }
      },
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "APP_BASE_URL": "https://ethio-poultry-app-staging.walidmurad65.workers.dev",
        "NEXT_PUBLIC_SUPABASE_URL": "https://uzmhpecehmlwojdmitgj.supabase.co",
        "SUPABASE_PROJECT_REF": "uzmhpecehmlwojdmitgj",
        "RECONCILIATION_AI_ENABLED": "true",
        "GROQ_MODEL": "openai/gpt-oss-120b"
      },
      "secrets": {
        "required": [
          "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "ADMIN_ACCESS_CODE",
          "GROQ_API_KEY",
          "MONITORING_INGEST_TOKEN"
        ]
      }
    }
  }
}
