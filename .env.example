# Deployment identity. Use local, ci, staging, or production.
APP_ENVIRONMENT=local
APP_RELEASE=local-development
APP_BASE_URL=http://localhost:3000

# Supabase application connection.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Required only for staging and production to prevent deploying to the wrong project.
SUPABASE_PROJECT_REF=

# Optional read-only AI guidance for deterministic Record Checks.
# Keep the key server-only. When enabled in staging/production, GROQ_API_KEY is required.
RECONCILIATION_AI_ENABLED=false
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Platform-console gate. Use a unique randomly generated value of at least 12 characters.
ADMIN_ACCESS_CODE=replace-with-a-strong-random-code

# Optional feed-template extraction integration.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_VISION_MODEL=llama3.2-vision

# Used only by `npm run db:verify`; never expose this to browser code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Browser release-gate accounts. Use dedicated staging-only users and never
# commit real credentials. E2E_REQUIRE_ROLE_CREDENTIALS=true makes missing
# role accounts fail the protected staging gate instead of skipping tests.
E2E_REQUIRE_ROLE_CREDENTIALS=false
E2E_CEO_EMAIL=
E2E_CEO_PASSWORD=
E2E_FARM_MANAGER_EMAIL=
E2E_FARM_MANAGER_PASSWORD=
E2E_SYSTEM_ADMIN_EMAIL=
E2E_SYSTEM_ADMIN_PASSWORD=
E2E_ADMIN_ACCESS_CODE=
